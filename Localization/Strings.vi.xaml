<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="Str_WindowTitle">Tạo nhãn sản phẩm</system:String>

    <!-- Tabs -->
    <system:String x:Key="Str_Tab_Export">Xuất file</system:String>
    <system:String x:Key="Str_Tab_Settings">Cài đặt</system:String>

    <!-- Tab: Xuất file -->
    <system:String x:Key="Str_SourceFileSection">File Excel nguồn</system:String>
    <system:String x:Key="Str_BtnChooseFile">Chọn file...</system:String>
    <system:String x:Key="Str_BtnDownloadTemplate">Tải file mẫu</system:String>
    <system:String x:Key="Str_NoFileChosen">Chưa chọn file...</system:String>
    <system:String x:Key="Str_OutputFolderSection">Thư mục lưu file xuất</system:String>
    <system:String x:Key="Str_BtnChooseFolder">Chọn thư mục...</system:String>
    <system:String x:Key="Str_NoFolderChosen">Chưa chọn thư mục...</system:String>
    <system:String x:Key="Str_ChkIncludeSupplier">Bao gồm thông tin Nhà cung cấp</system:String>
    <system:String x:Key="Str_SupplierName">Nhà cung cấp</system:String>
    <system:String x:Key="Str_SupplierAddress">Địa chỉ nhà cung cấp</system:String>
    <system:String x:Key="Str_BtnExport">Xuất file</system:String>

    <!-- Tab: Cài đặt -->
    <system:String x:Key="Str_ImporterSection">Nhập khẩu và phân phối</system:String>
    <system:String x:Key="Str_ImporterAddress">Địa chỉ nhà nhập khẩu</system:String>
    <system:String x:Key="Str_ProductionYearLabel">Năm sản xuất (mặc định lấy năm hiện tại nếu để trống)</system:String>
    <system:String x:Key="Str_UsageInstructionsSection">Hướng dẫn sử dụng</system:String>
    <system:String x:Key="Str_StorageInstructionsLabel">Cách bảo quản</system:String>
    <system:String x:Key="Str_LanguageLabel">Ngôn ngữ</system:String>
    <system:String x:Key="Str_ChkDarkMode">Chế độ tối</system:String>
    <system:String x:Key="Str_BtnSaveSettings">Lưu cài đặt</system:String>
    <system:String x:Key="Str_BtnRestoreDefaults">Khôi phục mặc định</system:String>

    <!-- Update banner -->
    <system:String x:Key="Str_UpdateAvailable">Có bản cập nhật mới</system:String>
    <system:String x:Key="Str_UpdateAvailableFormat">Có bản cập nhật mới: v{0} — bấm "Cập nhật ngay" để cài đặt.</system:String>
    <system:String x:Key="Str_BtnUpdateNow">Cập nhật ngay</system:String>
    <system:String x:Key="Str_Updating">Đang cập nhật...</system:String>
    <system:String x:Key="Str_UpdateFailed">Cập nhật thất bại. Vui lòng kiểm tra kết nối mạng và thử lại.</system:String>

    <!-- Toast -->
    <system:String x:Key="Str_BtnOpenFolder">Mở thư mục</system:String>

    <!-- Preview window -->
    <system:String x:Key="Str_BtnPreview">Xem trước</system:String>
    <system:String x:Key="Str_PreviewWindowTitle">Xem trước tem phụ</system:String>
    <system:String x:Key="Str_PreviewCountFormat">Sẽ xuất {0} sản phẩm</system:String>
    <system:String x:Key="Str_PreviewTotalQuantityFormat">Tổng số lượng: {0}</system:String>
    <system:String x:Key="Str_PreviewFileNameFormat">Tên file: {0}</system:String>
    <system:String x:Key="Str_PreviewInvalidQuantityFormat">({0} sản phẩm có số lượng trống hoặc không phải số, không tính vào tổng)</system:String>
    <system:String x:Key="Str_PreviewEmptyFieldsFormat">Các trường sau đang trống ở tất cả tem: {0}</system:String>
    <system:String x:Key="Str_PreviewNoOutputFolder">Chọn thư mục lưu file xuất ở cửa sổ chính để xuất file.</system:String>
    <system:String x:Key="Str_PreviewEmptyValue">(trống)</system:String>
    <system:String x:Key="Str_BtnClose">Đóng</system:String>
    <system:String x:Key="Str_PreviewLoadError">Lỗi khi đọc file nguồn: {0}</system:String>
    <system:String x:Key="Str_ColStt">STT</system:String>
    <system:String x:Key="Str_ColContent">THÔNG TIN SẢN PHẨM</system:String>
    <system:String x:Key="Str_ColQuantity">SỐ LƯỢNG</system:String>

    <!-- Dialogs -->
    <system:String x:Key="Str_Dialog_ChooseSourceFile">Chọn file Excel nguồn</system:String>
    <system:String x:Key="Str_Dialog_SaveTemplate">Lưu file mẫu</system:String>
    <system:String x:Key="Str_ExcelFilter">Excel files (*.xlsx)|*.xlsx</system:String>
    <system:String x:Key="Str_TemplateFileName">Mau_du_lieu_san_pham.xlsx</system:String>

    <!-- Status / messages -->
    <system:String x:Key="Str_TemplateDownloaded">Đã tải file mẫu thành công.</system:String>
    <system:String x:Key="Str_TemplateCreateError">Lỗi khi tạo file mẫu: {0}</system:String>
    <system:String x:Key="Str_ValidSourceFileRequired">Vui lòng chọn file Excel nguồn hợp lệ.</system:String>
    <system:String x:Key="Str_ValidOutputFolderRequired">Vui lòng chọn thư mục lưu file xuất.</system:String>
    <system:String x:Key="Str_ExportSuccess">Xuất file thành công.</system:String>
    <system:String x:Key="Str_ExportError">Lỗi khi xuất file: {0}</system:String>
    <system:String x:Key="Str_OpenFolderError">Không thể mở thư mục chứa file (file hoặc thư mục có thể đã bị xoá/đổi tên).</system:String>
    <system:String x:Key="Str_SettingsSaved">Đã lưu cài đặt.</system:String>
    <system:String x:Key="Str_RestoreDefaultsConfirm">Thao tác này sẽ xoá toàn bộ cài đặt đã lưu và đưa các trường về giá trị mặc định. Bạn có chắc chắn muốn tiếp tục?</system:String>
    <system:String x:Key="Str_RestoreDefaultsTitle">Khôi phục mặc định</system:String>
    <system:String x:Key="Str_DefaultsRestored">Đã khôi phục mặc định.</system:String>

    <!-- Status bar -->
    <system:String x:Key="Str_StatusReady">Sẵn sàng</system:String>
    <system:String x:Key="Str_StatusReading">Đang đọc file…</system:String>
    <system:String x:Key="Str_StatusExporting">Đang xuất file…</system:String>
    <system:String x:Key="Str_StatusExported">Đã xuất {0} nhãn</system:String>

</ResourceDictionary>
