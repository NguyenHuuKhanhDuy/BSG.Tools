<Window x:Class="BSG.Tools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_WindowTitle}" Height="720" Width="640"
        MinHeight="670" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource {x:Type Window}}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" PreviewMouseLeftButtonDown="MainTabs_PreviewMouseLeftButtonDown">

            <!-- ===================== TAB: XUẤT FILE ===================== -->
            <TabItem Header="{DynamicResource Str_Tab_Export}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Horizontal margin leaves room for the card shadows inside the ScrollViewer's clip. -->
                <StackPanel Margin="6,20,6,8">

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <DockPanel Margin="{StaticResource SpacingLabel}">
                                <Button x:Name="BtnDownloadTemplate" Content="{DynamicResource Str_BtnDownloadTemplate}"
                                        DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}"
                                        VerticalAlignment="Center" Click="BtnDownloadTemplate_Click"/>
                                <TextBlock Text="{DynamicResource Str_SourceFileSection}" Style="{StaticResource FieldLabelStyle}"
                                           Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="{StaticResource SpacingField}">
                                <Button x:Name="BtnChooseFile" Content="{DynamicResource Str_BtnChooseFile}" Width="120"
                                        DockPanel.Dock="Right" Margin="10,0,0,0" Click="BtnChooseFile_Click"/>
                                <TextBox x:Name="TxtSourceFile" IsReadOnly="True" VerticalContentAlignment="Center"
                                         Style="{StaticResource ReadOnlyPathTextBoxStyle}" Tag="{DynamicResource Str_NoFileChosen}"/>
                            </DockPanel>

                            <TextBlock Text="{DynamicResource Str_OutputFolderSection}" Style="{StaticResource FieldLabelStyle}"/>
                            <DockPanel>
                                <Button x:Name="BtnChooseFolder" Content="{DynamicResource Str_BtnChooseFolder}" Width="120"
                                        DockPanel.Dock="Right" Margin="10,0,0,0" Click="BtnChooseFolder_Click"/>
                                <TextBox x:Name="TxtOutputFolder" IsReadOnly="True" VerticalContentAlignment="Center"
                                         Style="{StaticResource ReadOnlyPathTextBoxStyle}" Tag="{DynamicResource Str_NoFolderChosen}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <CheckBox x:Name="ChkIncludeSupplier" Content="{DynamicResource Str_ChkIncludeSupplier}"
                                      Margin="{StaticResource SpacingField}"
                                      Checked="ChkIncludeSupplier_Changed" Unchecked="ChkIncludeSupplier_Changed"/>

                            <TextBlock x:Name="LblSupplierName" Text="{DynamicResource Str_SupplierName}" Style="{StaticResource SupplierFieldLabelStyle}"/>
                            <TextBox x:Name="TxtSupplierName" Margin="{StaticResource SpacingField}"/>

                            <TextBlock x:Name="LblSupplierAddress" Text="{DynamicResource Str_SupplierAddress}" Style="{StaticResource SupplierFieldLabelStyle}"/>
                            <TextBox x:Name="TxtSupplierAddress"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource DisabledCursorHostStyle}" Margin="0,0,10,0">
                            <Button x:Name="BtnPreview" Content="{DynamicResource Str_BtnPreview}" Height="40" FontSize="14"
                                    Click="BtnPreview_Click"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DisabledCursorHostStyle}">
                            <Button x:Name="BtnExport" Content="{DynamicResource Str_BtnExport}" Height="40" FontSize="14"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="BtnExport_Click"/>
                        </Border>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== TAB: CÀI ĐẶT ===================== -->
            <TabItem Header="{DynamicResource Str_Tab_Settings}">
                <Grid Margin="0,20,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,0,6,0">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_ImporterSection}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtImporter" Margin="{StaticResource SpacingField}"/>

                                <TextBlock Text="{DynamicResource Str_ImporterAddress}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtImporterAddress" Margin="{StaticResource SpacingField}"/>

                                <TextBlock Text="{DynamicResource Str_ProductionYearLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtProductionYear" MaxLength="4"
                                         PreviewTextInput="TxtProductionYear_PreviewTextInput"
                                         DataObject.Pasting="TxtProductionYear_Pasting"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_UsageInstructionsSection}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtUsageInstructions" Margin="{StaticResource SpacingField}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

                                <TextBlock Text="{DynamicResource Str_StorageInstructionsLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtStorageInstructions"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Row="1" Margin="6,4,6,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <ComboBox x:Name="CmbLanguage" Width="130" Margin="0,0,16,0" VerticalAlignment="Center"
                                      SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem Content="Tiếng Việt" Tag="vi"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                            </ComboBox>
                            <CheckBox x:Name="ChkDarkMode" Content="{DynamicResource Str_ChkDarkMode}"
                                      VerticalAlignment="Center"
                                      Checked="ChkDarkMode_Changed" Unchecked="ChkDarkMode_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnSaveSettings" Content="{DynamicResource Str_BtnSaveSettings}" Height="38" Width="160"
                                    HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"
                                    Click="BtnSaveSettings_Click"/>
                            <Button x:Name="BtnRestoreDefaults" Content="{DynamicResource Str_BtnRestoreDefaults}" Height="38"
                                    HorizontalAlignment="Left" Margin="10,0,0,0"
                                    Click="BtnRestoreDefaults_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ===================== UPDATE BANNER / TOAST ===================== -->
        <StackPanel Grid.Row="1">
            <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="0,14,0,0"
                    Background="{DynamicResource BrushAccentSubtle}" BorderBrush="{DynamicResource BrushAccent}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="12,8">
                <DockPanel>
                    <Button x:Name="BtnUpdateNow" Content="{DynamicResource Str_BtnUpdateNow}" DockPanel.Dock="Right"
                            Style="{StaticResource AccentButtonStyle}" Margin="12,0,0,0" Click="BtnUpdateNow_Click"/>
                    <TextBlock x:Name="TxtUpdateBanner" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{DynamicResource Str_UpdateAvailable}"/>
                </DockPanel>
            </Border>

            <Border x:Name="Toast" Visibility="Collapsed" Margin="0,14,0,0"
                    Background="{DynamicResource BrushCardBackground}" BorderBrush="{DynamicResource BrushStatusSuccess}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="12,8">
                <DockPanel>
                    <Button x:Name="BtnToastOpenFolder" Content="{DynamicResource Str_BtnOpenFolder}" DockPanel.Dock="Right"
                            Margin="12,0,0,0" Click="BtnToastOpenFolder_Click"/>
                    <TextBlock x:Name="TxtToastMessage" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ===================== STATUS BAR ===================== -->
        <!-- TxtStatus text/colour and StatusDot colour are driven by SetStatus() in code-behind. -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,7" CornerRadius="{StaticResource RadiusControl}"
                Background="{DynamicResource BrushStatusBarBackground}">
            <DockPanel>
                <TextBlock x:Name="TxtVersion" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{DynamicResource BrushTextSecondary}"/>
                <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           MouseLeftButtonUp="TxtStatus_MouseLeftButtonUp"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
