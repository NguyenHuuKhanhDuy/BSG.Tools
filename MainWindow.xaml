<Window x:Class="BSG.Tools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo nhãn sản phẩm" Height="580" Width="620"
        MinHeight="650" MinWidth="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ===================== TAB: XUẤT FILE ===================== -->
            <TabItem Header="Xuất file">
                <StackPanel Margin="0,20,0,0">

                    <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="File Excel nguồn" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,16">
                                <Button x:Name="BtnChooseFile" Content="Chọn file..." Width="110"
                                        DockPanel.Dock="Right" Margin="8,0,0,0" Click="BtnChooseFile_Click"/>
                                <Button x:Name="BtnDownloadTemplate" Content="Tải file mẫu"
                                        DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,6" Click="BtnDownloadTemplate_Click"/>
                                <TextBox x:Name="TxtSourceFile" IsReadOnly="True" VerticalContentAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Thư mục lưu file xuất" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button x:Name="BtnChooseFolder" Content="Chọn thư mục..." Width="110"
                                        DockPanel.Dock="Right" Margin="8,0,0,0" Click="BtnChooseFolder_Click"/>
                                <TextBox x:Name="TxtOutputFolder" IsReadOnly="True" VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkIncludeSupplier" Content="Bao gồm thông tin Nhà cung cấp"
                                      Margin="0,0,0,12" Checked="ChkIncludeSupplier_Changed" Unchecked="ChkIncludeSupplier_Changed"/>

                            <TextBlock Text="Nhà cung cấp" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtSupplierName" Margin="0,0,0,12"/>

                            <TextBlock Text="Địa chỉ nhà cung cấp" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtSupplierAddress"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnExport" Content="Xuất file" Height="38" FontSize="14"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="BtnExport_Click"/>
                </StackPanel>
            </TabItem>

            <!-- ===================== TAB: CÀI ĐẶT ===================== -->
            <TabItem Header="Cài đặt">
                <StackPanel Margin="0,20,0,0">

                    <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Nhập khẩu và phân phối" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtImporter" Margin="0,0,0,14"/>

                            <TextBlock Text="Địa chỉ nhà nhập khẩu" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtImporterAddress" Margin="0,0,0,14"/>

                            <TextBlock Text="Năm sản xuất (mặc định lấy năm hiện tại nếu để trống)"
                                       Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtProductionYear"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Hướng dẫn sử dụng" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtUsageInstructions" Margin="0,0,0,14"/>

                            <TextBlock Text="Cách bảo quản" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtStorageInstructions"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnSaveSettings" Content="Lưu cài đặt" Height="36" Width="160"
                            HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"
                            Click="BtnSaveSettings_Click"/>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- ===================== UPDATE BANNER ===================== -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0"
                Background="{StaticResource BrushSecondaryButton}" BorderBrush="{StaticResource BrushAccent}"
                BorderThickness="1" CornerRadius="8" Padding="12,8">
            <DockPanel>
                <Button x:Name="BtnUpdateNow" Content="Cập nhật ngay" DockPanel.Dock="Right"
                        Style="{StaticResource AccentButtonStyle}" Margin="12,0,0,0" Click="BtnUpdateNow_Click"/>
                <TextBlock x:Name="TxtUpdateBanner" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Có bản cập nhật mới"/>
            </DockPanel>
        </Border>

        <!-- ===================== STATUS BAR ===================== -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="TxtVersion" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource BrushTextSecondary}"/>
            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontWeight="SemiBold"
                       MouseLeftButtonUp="TxtStatus_MouseLeftButtonUp"/>
        </DockPanel>
    </Grid>
</Window>
