<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BrushWindowBackground" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="BrushCardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#E2E5EA"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="#1F2430"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="BrushTextDisabled" Color="#ABB1BC"/>

    <SolidColorBrush x:Key="BrushAccent" Color="#2F6FED"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#255ACB"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#1D48A3"/>

    <SolidColorBrush x:Key="BrushSecondaryButton" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="BrushSecondaryButtonHover" Color="#E2E6ED"/>
    <SolidColorBrush x:Key="BrushSecondaryButtonPressed" Color="#D5DAE3"/>

    <SolidColorBrush x:Key="BrushDisabledBackground" Color="#F0F1F3"/>
    <SolidColorBrush x:Key="BrushReadOnlyBackground" Color="#F7F8FA"/>

    <SolidColorBrush x:Key="BrushStatusSuccess" Color="#1E8E3E"/>
    <SolidColorBrush x:Key="BrushStatusError" Color="#D93025"/>

    <SolidColorBrush x:Key="BrushWarningBackground" Color="#FFF6E0"/>
    <SolidColorBrush x:Key="BrushWarningBorder" Color="#F2C94C"/>
    <SolidColorBrush x:Key="BrushWarningText" Color="#8A5A00"/>

    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushAccentSubtle" Color="#EAF1FE"/>
    <SolidColorBrush x:Key="BrushAccentSubtlePressed" Color="#D6E4FD"/>
    <!-- Semi-transparent accent halo drawn around a focused input. -->
    <SolidColorBrush x:Key="BrushFocusGlow" Color="#402F6FED"/>
    <!-- Light cards are separated by shadow only, so no visible border. -->
    <SolidColorBrush x:Key="BrushCardBorder" Color="Transparent"/>
    <SolidColorBrush x:Key="BrushFieldLabel" Color="#374151"/>
    <SolidColorBrush x:Key="BrushStatusBarBackground" Color="#EBEDF1"/>
    <SolidColorBrush x:Key="BrushStatusBusy" Color="#2F6FED"/>
    <DropShadowEffect x:Key="EffectCardShadow" Color="#1F2430" BlurRadius="14" ShadowDepth="2"
                      Direction="270" Opacity="0.08"/>

</ResourceDictionary>
