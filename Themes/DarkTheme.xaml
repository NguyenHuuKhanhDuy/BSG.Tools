<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BrushWindowBackground" Color="#1B1C20"/>
    <SolidColorBrush x:Key="BrushCardBackground" Color="#25272C"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#3A3D44"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="#E8EAED"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#9AA0AC"/>
    <SolidColorBrush x:Key="BrushTextDisabled" Color="#5B5F68"/>

    <SolidColorBrush x:Key="BrushAccent" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#6FA1FF"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#3D75E0"/>

    <SolidColorBrush x:Key="BrushSecondaryButton" Color="#2E3138"/>
    <SolidColorBrush x:Key="BrushSecondaryButtonHover" Color="#383B43"/>
    <SolidColorBrush x:Key="BrushSecondaryButtonPressed" Color="#44474F"/>

    <SolidColorBrush x:Key="BrushDisabledBackground" Color="#2A2C31"/>
    <SolidColorBrush x:Key="BrushReadOnlyBackground" Color="#212327"/>

    <SolidColorBrush x:Key="BrushStatusSuccess" Color="#4CC26A"/>
    <SolidColorBrush x:Key="BrushStatusError" Color="#F26A5A"/>

    <SolidColorBrush x:Key="BrushWarningBackground" Color="#3A3120"/>
    <SolidColorBrush x:Key="BrushWarningBorder" Color="#8A6D1F"/>
    <SolidColorBrush x:Key="BrushWarningText" Color="#F2C94C"/>

    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushAccentSubtle" Color="#22304A"/>
    <SolidColorBrush x:Key="BrushAccentSubtlePressed" Color="#2A3D60"/>
    <!-- Semi-transparent accent halo drawn around a focused input. -->
    <SolidColorBrush x:Key="BrushFocusGlow" Color="#594C8DFF"/>
    <!-- Shadows barely show on a dark background, so dark cards get a thin border instead. -->
    <SolidColorBrush x:Key="BrushCardBorder" Color="#33363D"/>
    <SolidColorBrush x:Key="BrushFieldLabel" Color="#C3C7CF"/>
    <SolidColorBrush x:Key="BrushStatusBarBackground" Color="#222328"/>
    <SolidColorBrush x:Key="BrushStatusBusy" Color="#4C8DFF"/>
    <!-- Bar on inputs whose value differs from the last saved settings. -->
    <SolidColorBrush x:Key="BrushModified" Color="#F2C94C"/>
    <DropShadowEffect x:Key="EffectCardShadow" Color="#000000" BlurRadius="14" ShadowDepth="2"
                      Direction="270" Opacity="0.25"/>

</ResourceDictionary>
