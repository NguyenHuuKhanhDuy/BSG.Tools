<Window x:Class="BSG.Tools.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_PreviewWindowTitle}" Height="680" Width="760"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{DynamicResource {x:Type Window}}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== SUMMARY ===================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TxtCount" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtFileName" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource BrushTextSecondary}"/>
            <TextBlock x:Name="TxtInvalidQuantity" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource BrushWarningText}"/>
        </StackPanel>

        <Border x:Name="WarningBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,12"
                Background="{DynamicResource BrushWarningBackground}" BorderBrush="{DynamicResource BrushWarningBorder}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="12,8">
            <TextBlock x:Name="TxtWarning" TextWrapping="Wrap" Foreground="{DynamicResource BrushWarningText}"/>
        </Border>

        <!-- ===================== LABEL LIST ===================== -->
        <!-- Mirrors the exported sheet: STT | bordered content block (bold centered
             title + "Label: value" lines) | SL. Only content and order are meant to
             match Excel; wrapping/heights are approximate. -->
        <!-- Inner rows carry their own margins, so the card's padding/margin are reset. -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,16,28,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_ColStt}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_ColContent}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource Str_ColQuantity}" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>

                <ItemsControl x:Name="LabelList" Grid.Row="1"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True" Padding="20,0,20,20">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Stt}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Border Grid.Column="1" BorderBrush="{DynamicResource BrushTextSecondary}" BorderThickness="1"
                                        Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"
                                                   TextAlignment="Center" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBlock x:Name="filledLine" TextWrapping="Wrap">
                                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Bold"/><Run Text=": " FontWeight="Bold"/><Run Text="{Binding Value, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock x:Name="emptyLine" TextWrapping="Wrap" Visibility="Collapsed">
                                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Bold"/><Run Text=": " FontWeight="Bold"/><Run Text="{DynamicResource Str_PreviewEmptyValue}" FontStyle="Italic" Foreground="{DynamicResource BrushWarningText}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                            <Setter TargetName="filledLine" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="emptyLine" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding Quantity}" FontWeight="Bold" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ===================== FOOTER ===================== -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="BtnClose" Content="{DynamicResource Str_BtnClose}" Height="36" Width="100"
                        IsCancel="True" Click="BtnClose_Click"/>
                <Button x:Name="BtnPreviewExport" Content="{DynamicResource Str_BtnExport}" Height="36" Width="140"
                        Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}" Click="BtnPreviewExport_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtPreviewStatus" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource BrushTextSecondary}"/>
        </DockPanel>
    </Grid>
</Window>
